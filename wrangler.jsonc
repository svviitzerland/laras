{
	// Konfigurasi untuk Cloudflare. Dengan berkas ini, wrangler tidak lagi
	// menjalankan penyetelan otomatis yang sempat menyisipkan
	// `wrangler types --check` ke dalam skrip build.
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "portfolio-laras",
	"compatibility_date": "2026-07-01",
	"compatibility_flags": ["nodejs_compat"],

	// Hasil build dari @sveltejs/adapter-cloudflare.
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	}
}
